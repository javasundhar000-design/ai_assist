<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- DEV ONLY: allows plaintext HTTP to your local backend during
         development. Remove or restrict this before shipping — production
         builds should only ever talk to your backend over HTTPS. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <!-- Add your computer's LAN IP here for physical-device testing,
             e.g. <domain includeSubdomains="false">192.168.1.42</domain> -->
    </domain-config>
</network-security-config>